# .env.example — 로컬 개발용 환경변수 템플릿
# 실제 값은 여기 채우지 말 것. 사용법:
#   cp .env.example .env
#   .env에 아래 각 항목의 실제 값을 채운다 (.env는 Git에 커밋되지 않음)
# 값을 어디서 확인하는지는 docs/infrastructure/05_Secrets_ConfigMaps.md 참조.

# PostgreSQL (datagokr) — Metadata DB
DB_HOST=localhost
DB_PORT=30433
DB_NAME=datagokr
DB_USER=admin
DB_PASSWORD=<postgres-174-secret 에서 확인>

# MinIO (별도 프로젝트 전용 — metadata-ingestion에서는 사용 안 함, 참고용으로만 남겨둠)
MINIO_ENDPOINT=http://localhost:30900
MINIO_ACCESS_KEY=<접근 키>
MINIO_SECRET_KEY=<common-secret 에서 확인>

# SeaweedFS (S3 API) — metadata-ingestion 전용 오브젝트 스토리지
S3_ENDPOINT=http://localhost:30920
S3_ACCESS_KEY=<접근 키>
S3_SECRET_KEY=<서버에서 확인: kubectl -n seaweedfs get secret seaweedfs-s3-secret -o jsonpath='{.data.S3_SECRET_KEY}' | base64 -d>
S3_BUCKET=metadata-ingestion
S3_REGION=us-east-1

# Naver API (플랫폼 공유 폴백용 — 데이터셋별 키는 dataset_credentials 테이블 사용)
NAVER_CLIENT_ID=<configs/config.yaml 에서 확인>
NAVER_CLIENT_SECRET=<configs/config.yaml 에서 확인>

# dataset_credentials 테이블 암호화 키 (pgcrypto)
ENCRYPTION_KEY=<dataset-credentials-encryption-key Secret에서 확인>

# 실행 주체 (로컬 실행 시)
TRIGGERED_BY=manual
